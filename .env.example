# Copy this file to .env and fill in your keys
# .env is never committed to git (it's in .gitignore)

ANTHROPIC_API_KEY=your_anthropic_key_here
ODDS_API_KEY=your_odds_api_key_here
SPORTSDB_API_KEY=1

# Alpaca paper trading (get keys at alpaca.markets → Paper Trading → API Keys)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# FRED (Federal Reserve Economic Data) — free, register at fred.stlouisfed.org
# Used for read-only macro regime tags (Dalio 3-force overlay); model runs fine without it
FRED_API_KEY=your_fred_key_here

# Finnhub — free tier (60 calls/min), register at finnhub.io
# Used by the Low Value engine for news, market cap, and fundamentals; the engine
# just scans fewer symbols per day without it (fails safe)
FINNHUB_API_KEY=your_finnhub_key_here

# SEC EDGAR requires a descriptive User-Agent, not an API key — set this to your
# own contact info per SEC's fair-access policy. Falls back to a generic default.
SEC_EDGAR_USER_AGENT=YourName your_email@example.com

# HSIP (github.com/rewired89/HSIP-1PHASE) — tamper-proof, independently verifiable
# attestation of Predicta's real trading transactions. Both required, or attestation
# is silently disabled (fails safe, like every other optional integration above).
# HSIP_API_KEY must be a dedicated ai_agent-type key created for Predicta — never
# HSIP's admin/root key. See HSIP's CLAUDE.md, "Trading Bot Integration".
HSIP_API_KEY=your_hsip_ai_agent_key_here
HSIP_API_URL=http://127.0.0.1:7474

# Real Alpaca paper-trading orders for the automated High Value runner (not just
# hypothetical logging). Off by default — set to "true" to actually place bracket
# orders on entry and attest each real transaction to HSIP. Zero financial risk:
# fetchers/alpaca.py hard-refuses anything but the paper trading endpoint.
HIGH_VALUE_LIVE_PAPER_TRADING=false
